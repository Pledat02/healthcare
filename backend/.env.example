# =============================================================================
#  Bien moi truong cho STAGING/PROD - healthcare backend
#  Copy thanh .env (da gitignore) hoac dat truc tiep tren moi truong deploy.
#  DEV: khong can dat gi - application.yaml da co default localhost.
#  PROD: PHAI dat het de khong dung default localhost + khong luu secret trong repo.
# =============================================================================

# ----- Profile -----
SPRING_PROFILES_ACTIVE=prod

# ----- Database (compose.yaml map sang SPRING_DATASOURCE_*) -----
# Ca 5 service dung chung Supabase Singapore; moi Hikari pool toi da 2 connections.
DOCTOR_DB_URL=jdbc:postgresql://<singapore-pooler-host>:5432/postgres?sslmode=require
DOCTOR_DB_USER=<singapore-db-user>
DOCTOR_DB_PASSWORD=<singapore-db-password>                # SECRET - khong commit
APPOINTMENT_DB_URL=jdbc:postgresql://<singapore-pooler-host>:5432/postgres?sslmode=require
APPOINTMENT_DB_USER=<singapore-db-user>
APPOINTMENT_DB_PASSWORD=<singapore-db-password>           # SECRET
NOTIFICATION_DB_URL=jdbc:postgresql://<singapore-pooler-host>:5432/postgres?sslmode=require
NOTIFICATION_DB_USER=<singapore-db-user>
NOTIFICATION_DB_PASSWORD=<singapore-db-password>          # SECRET
PATIENT_DB_URL=jdbc:postgresql://<singapore-pooler-host>:5432/postgres?sslmode=require
PATIENT_DB_USER=<singapore-db-user>
PATIENT_DB_PASSWORD=<singapore-db-password>               # SECRET
MEDICALRECORD_DB_URL=jdbc:postgresql://<singapore-pooler-host>:5432/postgres?sslmode=require
MEDICALRECORD_DB_USER=<singapore-db-user>
MEDICALRECORD_DB_PASSWORD=<singapore-db-password>         # SECRET
# Nen dung database/schema rieng cho security event va audit log.
SECURITY_DB_URL=jdbc:postgresql://<singapore-pooler-host>:5432/postgres?sslmode=require
SECURITY_DB_USER=<security-db-writer>
SECURITY_DB_PASSWORD=<security-db-password>               # SECRET

# ----- Keycloak -----
KEYCLOAK_ISSUER_URI=https://<keycloak-host>/realms/healthcare
KEYCLOAK_SERVER_URL=https://<keycloak-host>
KEYCLOAK_REALM=healthcare
KEYCLOAK_ADMIN_CLIENT_ID=healthcare-admin-cli
KEYCLOAK_INTERNAL_CLIENT_ID=healthcare-admin-cli
# Secret cua service-account (doctor + appointment) - SECRET, dat qua secret manager:
#   keycloak.admin-client-secret / keycloak.internal-client-secret

# ----- Inter-service URLs (cac service goi nhau) -----
PATIENT_SERVICE_URL=http://patient-service:8081
DOCTOR_SERVICE_URL=http://doctor-service:8082
APPOINTMENT_SERVICE_URL=http://appointment-service:8083
NOTIFICATION_SERVICE_URL=http://notification-service:8084
MEDICAL_RECORD_SERVICE_URL=http://medical-record-service:8085
SECURITY_SERVICE_URL=http://security-service:8086

# ----- API Gateway: routes + CORS -----
PATIENT_SERVICE_URI=http://patient-service:8081
DOCTOR_SERVICE_URI=http://doctor-service:8082
APPOINTMENT_SERVICE_URI=http://appointment-service:8083
NOTIFICATION_SERVICE_URI=http://notification-service:8084
MEDICAL_RECORD_SERVICE_URI=http://medical-record-service:8085
SECURITY_SERVICE_URI=http://security-service:8086
FRONTEND_URL=https://<frontend-domain>

# ----- Kafka (appointment producer, notification consumer) -----
# Trong compose.yaml: dung service DNS "kafka". Ngoai compose: doi thanh host that.
KAFKA_SERVERS=kafka:9092
SECURITY_EVENT_TOPIC=security-access-events

# ----- Redis (doctor-service cache) -----
# Trong compose.yaml: dung service DNS "redis".
REDIS_HOST=redis
REDIS_PORT=6379
SECURITY_RATE_LIMIT_PER_MINUTE=120
# Chi true khi reverse proxy da strip header X-Forwarded-For do client tu gui.
SECURITY_TRUST_FORWARDED_FOR=false
# ----- Cloudflare Tunnel (token la SECRET, khong commit gia tri that) -----
# Khi true, Gateway chi lay CF-Connecting-IP tu connector 172.29.250.2.
SECURITY_CLOUDFLARE_ENABLED=true
SECURITY_CLOUDFLARE_REQUIRED=true
SECURITY_CLOUDFLARE_TRUSTED_PROXY_CIDRS=172.29.250.2/32
CLOUDFLARE_TUNNEL_TOKEN=<cloudflare-tunnel-token>
GATEWAY_LOCAL_PORT=8090
# Raw security event; alert/audit khong bi job nay xoa.
SECURITY_EVENT_RETENTION_DAYS=30

# ----- Doctor avatars (Supabase Storage) -----
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<sb_secret-or-legacy-service-role-key> # SECRET - server only, never VITE_*
SUPABASE_DOCTOR_AVATAR_BUCKET=doctor-avatars
# One-time demo import; turn back to false after the first successful run.
DOCTOR_AVATAR_SEED_ENABLED=false

# ----- Mail SMTP (notification US-08/09) - password la SECRET -----
MAIL_HOST=<smtp-host>
MAIL_PORT=587
MAIL_USERNAME=<smtp-user>
MAIL_PASSWORD=<smtp-password>                     # SECRET - khong commit
MAIL_FROM=<sender@domain>
