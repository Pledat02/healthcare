# Bien cho edge Caddy (infrastructure/vps/compose.caddy.yaml). Copy thanh .env.
# .env da bi .gitignore o muc infrastructure/vps.

# Domain goc da tro DNS ve IP VPS. Caddy phuc vu auth.<DOMAIN> + api.<DOMAIN>.
DOMAIN=example.com

# Email dang ky Let's Encrypt (nhan canh bao het han chung chi).
ACME_EMAIL=you@example.com
