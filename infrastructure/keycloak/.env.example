# Public DNS name. Point its A/AAAA record to this host before starting Caddy.
KEYCLOAK_HOSTNAME=auth.example.com

# Use long, unique values. Never commit the real .env file.
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=replace-with-at-least-32-random-characters
KEYCLOAK_BOOTSTRAP_ADMIN_USERNAME=kc-admin
KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD=replace-with-at-least-32-random-characters

# Secret token cua Tunnel rieng cho auth.example.com.
CLOUDFLARE_KEYCLOAK_TUNNEL_TOKEN=<cloudflare-keycloak-tunnel-token>
# Caddy chi bind mot HTTP recovery port tren loopback; public TLS ket thuc tai Cloudflare.
KEYCLOAK_LOCAL_PROXY_PORT=8088

# ----- Secrets da SCRUB khoi realm-config/healthcare-realm.json (placeholder ${env.*}) -----
# Dat trong Admin Console SAU khi import, hoac thay placeholder trong file truoc khi import.
GOOGLE_CLIENT_ID=<google-oauth-client-id>
GOOGLE_CLIENT_SECRET=<google-oauth-client-secret>       # SECRET
KEYCLOAK_ADMIN_CLIENT_SECRET=<healthcare-admin-cli-secret>  # SECRET
