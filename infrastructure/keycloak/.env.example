# Public DNS name. Point its A/AAAA record to this host before starting Caddy.
KEYCLOAK_HOSTNAME=auth.example.com

# Use long, unique values. Never commit the real .env file.
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=replace-with-at-least-32-random-characters
KEYCLOAK_BOOTSTRAP_ADMIN_USERNAME=kc-admin
KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD=replace-with-at-least-32-random-characters
