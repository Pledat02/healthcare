# DEV: de trong VITE_API_URL -> dung proxy '/api' cua Vite (vite.config.js) -> localhost:8090
# PROD (Vercel): dat VITE_API_URL = URL public cua api-gateway, gom ca /api. Vd:
#   VITE_API_URL=https://api.your-domain.com/api
VITE_API_URL=

# Keycloak: PROD phai la URL public (khong duoc localhost) de redirect dang nhap hoat dong
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=healthcare
VITE_KEYCLOAK_CLIENT_ID=healthcare-app
VITE_GOOGLE_IDP_ALIAS=google
